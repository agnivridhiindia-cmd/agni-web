# Agnivridhi India — Environment Variables Configuration
# Copy this file to .env.local for local overrides.

# Canonical Production Site URL
NEXT_PUBLIC_SITE_URL=https://agnivridhiindia.com

# ------------------------------------------------------------------------------
# Inbound Contact Form Email Delivery
# All form submissions from users will be delivered to CONTACT_TO_EMAIL
# ------------------------------------------------------------------------------
CONTACT_TO_EMAIL=info@agnivridhiindia.com

# OPTION A: SMTP Delivery via Nodemailer (Recommended for Gmail / Webmail)
# Works with any email host (Gmail, Google Workspace, Zoho, Hostinger, cPanel, etc.)
#
# For Gmail / Google Workspace:
# 1. Enable 2-Step Verification in your Google Account.
# 2. Generate an "App Password": https://myaccount.google.com/apppasswords
# 3. Fill in:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@agnivridhiindia.com
SMTP_PASS=your_16_character_app_password
CONTACT_FROM_EMAIL="Agnivridhi Portal" <info@agnivridhiindia.com>

# For Custom Domain Webmail / cPanel / Hostinger:
# SMTP_HOST=mail.agnivridhiindia.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@agnivridhiindia.com
# SMTP_PASS=your_email_password
# CONTACT_FROM_EMAIL="Agnivridhi Portal" <info@agnivridhiindia.com>

# OPTION B: Resend API (HTTP-based delivery)
# 1. Create a free API key at https://resend.com/api-keys
# 2. Add your key below:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_FROM_EMAIL=onboarding@resend.dev
