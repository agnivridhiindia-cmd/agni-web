# Agnivridhi India — Environment Variables Configuration
# Copy this file to .env.local for local overrides if necessary.

# Canonical Production Site URL
NEXT_PUBLIC_SITE_URL=https://agnivridhiindia.com

# Inbound Diagnostic Inquiry Delivery (Resend API)
# Get a free API key from https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_FROM_EMAIL=inquiries@your-verified-domain.com
CONTACT_TO_EMAIL=advisory@agnivridhiindia.com

# Optional: Inbound Inquiry Webhook / Notification Endpoint
# INQUIRY_NOTIFICATION_ENDPOINT=https://api.example.com/webhooks/inquiry

