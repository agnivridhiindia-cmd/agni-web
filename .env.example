# Agnivridhi India — Environment Variables Configuration
# Copy this file to .env.local for local overrides.

# Canonical Production Site URL
NEXT_PUBLIC_SITE_URL=https://agnivridhiindia.com

# ------------------------------------------------------------------------------
# Inbound Contact Form Email Delivery
# All form submissions from users will be delivered to CONTACT_TO_EMAIL.
# (You can also specify multiple comma-separated emails, e.g. info@agnivridhiindia.com, rahul@agnivridhiindia.com)
# ------------------------------------------------------------------------------
CONTACT_TO_EMAIL=info@agnivridhiindia.com

# ==============================================================================
# OPTION 1 (RECOMMENDED): Hostinger Webmail SMTP
# Since your domain (agnivridhiindia.com) MX points to Hostinger (mx1.hostinger.com),
# you can use your official company mailbox directly:
# ==============================================================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@agnivridhiindia.com
SMTP_PASS=your_hostinger_webmail_password
CONTACT_FROM_EMAIL="Agnivridhi Portal" <info@agnivridhiindia.com>

# ==============================================================================
# OPTION 2: Gmail / Google Workspace SMTP
# If you prefer sending through a Gmail account:
# 1. Enable 2-Step Verification on that Google account.
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Use that EXACT Gmail address as SMTP_USER:
# ==============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_gmail_address@gmail.com
# SMTP_PASS=your_16_digit_google_app_password
# CONTACT_FROM_EMAIL="Agnivridhi Portal" <your_gmail_address@gmail.com>

# ==============================================================================
# OPTION 3: Resend API (Transactional Email Provider)
# 1. Create a free API key at https://resend.com/api-keys
# ==============================================================================
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_FROM_EMAIL=onboarding@resend.dev
